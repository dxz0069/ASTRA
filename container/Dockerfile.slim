# SLIM 变体：apt 层仅装技能库实际用到的工具（构建 ~20-30 分钟 vs 全家桶 ~2h+）
# 08-27 构建网络黑洞期补充：第三方二进制（katana/nuclei/dalfox/cloudfox/kerbrute +
# nuclei-templates）优先从本机 v5s 镜像拷贝（零网络依赖；sha256 已在 v5s 构建时校验）。
# 本地无 v5s 时该 stage 不可用——用 --build-arg 不行（FROM 不支持条件），需删除本块
# 回落文件中部标注的 wget 分支。比赛方/CI 全新环境走 wget 分支。
FROM astra-slim:v5s AS pinned-bins

FROM --platform=amd64 kalilinux/kali-rolling:latest

# apt 源显式固定（基础镜像把源放在 /etc/apt/sources.list.d/*.sources，其中东软镜像
# mirrors.neusoft.edu.cn 曾 DNS 不可达导致 kali-linux-headless 安装失败）。
# 默认 Kali 官方 CDN（CI/托管稳定）；国内构建可用 --build-arg KALI_MIRROR=清华/阿里镜像提速。
ARG KALI_MIRROR="http://http.kali.org/kali"
RUN rm -f /etc/apt/sources.list.d/* && \
    echo "deb ${KALI_MIRROR} kali-rolling main non-free contrib" > /etc/apt/sources.list && \
    apt update && \
    (apt -y install python3 python3-pip git curl wget jq tmux openssh-client sshpass socat ncat netcat-openbsd zip unzip zstd xz-utils file binutils gdb nmap sqlmap ffuf hashcat hydra john binwalk exiftool ruby ripgrep fd-find bsdextrautils iputils-ping rlwrap || (sleep 5 && apt -y install python3 python3-pip git curl wget jq tmux openssh-client sshpass socat ncat netcat-openbsd zip unzip zstd xz-utils file binutils gdb nmap sqlmap ffuf hashcat hydra john binwalk exiftool ruby ripgrep fd-find bsdextrautils iputils-ping rlwrap)) && \
    apt clean && \
    rm -rf /var/lib/apt/lists/* /usr/share/man /usr/share/doc /usr/share/locale/??

RUN useradd -m -s /bin/bash kali && \
    echo "kali ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
# slim 变体补充：kali-linux-headless 原本自带 sudo，精简列表需显式安装
# （noninteractive + confold：跳过 conffile 交互询问）
RUN DEBIAN_FRONTEND=noninteractive apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends -o Dpkg::Options::=--force-confold sudo && \
    rm -rf /var/lib/apt/lists/*
USER kali

# 工具层（V2 能力层追加 jadx/apktool：Android 静态逆向——run 10089 两题 Android 因无反编译
# 工具被迫走模拟器死路，FileBox 手写 DEX 解析器 6min；加层缓存失效属预期）
# V9 弱项补强（托管雷达 f=二进制 6/13、a=Web 缺 PHP）：radare2+r2ghidra 反编译、
# upx 脱壳、qemu-user 跨架构仿真（f2 固件/MCU）、php-cli（a 系源码审计/利用开发）、
# z3-solver（f2 序列号约束求解）；ropper 弃用（filebytes 源码构建必炸，pwntools ROP 类全覆盖）
RUN sudo rm -f /etc/apt/sources.list.d/* && \
    echo "deb ${KALI_MIRROR} kali-rolling main non-free contrib" | sudo tee /etc/apt/sources.list >/dev/null && \
    (sudo apt update || (sleep 5 && sudo apt update)) && \
    (sudo apt install -y bsdextrautils npm jq iputils-ping sshpass ncat rlwrap \
    bloodyad coercer enum4linux-ng pwncat chisel-common-binaries \
    dirsearch yq krb5-user gitleaks naabu nikto netexec adb python3-pwntools \
    jadx apktool radare2 rizin rz-ghidra upx-ucl strace xxd php-cli qemu-user \
    || (sleep 10 && sudo apt update && sudo apt install -y bsdextrautils npm jq iputils-ping sshpass ncat rlwrap \
    bloodyad coercer enum4linux-ng pwncat chisel-common-binaries \
    dirsearch yq krb5-user gitleaks naabu nikto netexec adb python3-pwntools \
    jadx apktool radare2 rizin rz-ghidra upx-ucl strace xxd php-cli qemu-user)) && \
    sudo apt clean && \
    sudo rm -rf /var/lib/apt/lists/* && \
    (for i in 1 2 3; do pip3 install -i http://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn pymongo z3-solver --break-system-packages && break || sleep $((i*8)); done)

# playwright CLI（独立层：npm 用国内源直连 + 三次重试，失败不拖垮 apt 层）
RUN for i in 1 2 3; do \
      sudo npm install -g --registry=https://registry.npmmirror.com @playwright/cli@latest && break || sleep 8; \
    done && \
    (cd /tmp && for i in 1 2 3; do playwright-cli install && break || sleep 8; done) && \
    sudo rm -rf /root/.npm /home/kali/.npm /home/kali/.cache /tmp/* 2>/dev/null; true

# 第三方二进制固定版本 + sha256 校验（供应链防护）。
# 08-27 网络黑洞期改走 pinned-bins 拷贝（v5s 构建时已做 sha256 校验，二进制同版本）。
# 回落分支（比赛方/CI 本地无 v5s 时改用）：原 wget+sha256 六连 fetch 脚本见 git 历史
# （5e97ce1 前的 Dockerfile.slim 本层）。
COPY --from=pinned-bins /usr/local/bin/katana /usr/local/bin/nuclei /usr/local/bin/dalfox /usr/local/bin/cloudfox /usr/local/bin/kerbrute /usr/local/bin/aliyun /usr/local/bin/
COPY --from=pinned-bins /home/kali/.local/nuclei-templates /home/kali/.local/nuclei-templates

# 知识库 + 工具 + PoC 库：全部从 v5s 拷贝（08-27 网络黑洞期 github 克隆大面积失败：
# hacktricks/hacktricks-cloud 被跳过、ysoserial 层是硬失败链会拖死构建——golden source
# 统一为 v5s，零网络依赖。回落分支（全新环境）见 git 历史 5e97ce1 前的同名 RUN 层）。
COPY --from=pinned-bins /home/kali/knowledges /home/kali/knowledges
COPY --from=pinned-bins /home/kali/tools /home/kali/tools
COPY --from=pinned-bins /home/kali/pocs /home/kali/pocs

# ripgrep/fd 已由基础层 apt 提供（ripgrep、fd-find），无需 GitHub deb 层
# aliyun CLI 已随 pinned-bins 拷贝（原 github release + sha256 层见 git 历史）

# pip 统一模式：tuna/aliyun 双镜像交替 ×3 轮，全部失败则层硬失败（for-loop 里 sleep 会
# 把失败吞成 0 退出码——08-27 v6 首建三层 pip 全被吞，astra/tccli/awscli/z3 静默缺席）
RUN ok=""; for idx in 1 2 3; do \
      if pip3 install -i http://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn pymongo z3-solver tccli awscli --break-system-packages; then ok=1; break; fi; \
      sleep $((idx*5)); \
      if pip3 install -i http://mirrors.aliyun.com/pypi/simple --trusted-host mirrors.aliyun.com pymongo z3-solver tccli awscli --break-system-packages; then ok=1; break; fi; \
      sleep $((idx*5)); \
    done; [ -n "$ok" ]

# astra 引擎（server + dispatcher）与靶场接入编排器
# 2026-08-29 v0.2 FGS 重建：执行底座只留 pi（@mariozechner/pi-coding-agent）——
# 最原始、完全可控的 Agent Loop（Less is More）。claude-code 与 playwright-mcp
# （CC 经 .claude.json 注入）整体移除；浏览器类需求由 worker 经 bash 直驱。
# 硬失败纪律：双镜像源装不上直接断构建；装完必须能输出版本号。
RUN ok=""; \
    for reg in https://registry.npmmirror.com https://registry.npmjs.org; do \
      echo "[pi] trying $reg"; \
      if sudo npm install -g --registry=$reg @mariozechner/pi-coding-agent@0.73.0; then ok=1; break; fi; \
      sleep $((RANDOM % 5 + 3)); \
    done; \
    [ -n "$ok" ] && pi --version

COPY ./astra /opt/astra
RUN cd /opt/astra && ok=""; for idx in 1 2 3; do \
      if pip3 install -i http://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn uv_build --break-system-packages && pip3 install -i http://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn . --break-system-packages; then ok=1; break; fi; \
      sleep $((idx*5)); \
      if pip3 install -i http://mirrors.aliyun.com/pypi/simple --trusted-host mirrors.aliyun.com uv_build --break-system-packages && pip3 install -i http://mirrors.aliyun.com/pypi/simple --trusted-host mirrors.aliyun.com . --break-system-packages; then ok=1; break; fi; \
      sleep $((idx*5)); \
    done; [ -n "$ok" ]
RUN ok=""; for idx in 1 2 3; do \
      if pip3 install -i http://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn tsec-benchmark --break-system-packages; then ok=1; break; fi; \
      sleep $((idx*5)); \
      if pip3 install -i http://mirrors.aliyun.com/pypi/simple --trusted-host mirrors.aliyun.com tsec-benchmark --break-system-packages; then ok=1; break; fi; \
      sleep $((idx*5)); \
    done; [ -n "$ok" ]
COPY ./container/astra_runner /opt/astra-runner
# V2-6 知识库（runner 按 /opt/knowledge/challenge-approaches.md 读取，ASTRA_KNOWLEDGE_FILE 可覆盖）
COPY ./container/knowledge /opt/knowledge

# 镜像默认入口：astra-runner（本地模式可手动执行 python3 /opt/astra-runner/runner.py）
ENTRYPOINT ["python3", "/opt/astra-runner/runner.py"]

# pi 安装层已前移至代码 COPY 之前（r10 层序修正：稳定依赖层前置，代码迭代不再重跑 npm）

RUN sudo chmod +x /usr/local/bin/kerbrute
RUN mkdir -p /home/kali/.config/nuclei && \
    echo >> /home/kali/.config/nuclei/config.yaml && \
    echo "disable-update-check: true" >> /home/kali/.config/nuclei/config.yaml && \
    echo "update-template-dir: /home/kali/.local/nuclei-templates" >> /home/kali/.config/nuclei/config.yaml && \
    rm -rf /home/kali/nuclei-templates
RUN sudo rm -rf /usr/lib/llvm-*/build || true; \
    (test -d /usr/lib/mysql/plugin/auth_pam_tool_dir && sudo chmod o+rx /usr/lib/mysql/plugin/auth_pam_tool_dir /etc/ssl/private || true)
RUN printf '%s\n' 'PS1="${PS1%\\n*} \[\033[0;36m\]\D{%y-%m-%d} - \t\[\033[;32m\]\n${PS1##*\\n}"' >> /home/kali/.bashrc && \
    mkdir -p /home/kali/workspace && cd /home/kali/workspace && git init
ENV PATH="/home/kali/.local/bin:${PATH}"
ENV TZ=Asia/Shanghai
ENV PYTHONUNBUFFERED=1
# 0.3.0 星尘记忆新机制：本地默认开、托管默认关（跑分吞吐优先，机制经本地轮实测后再开）
# ASTRA_CHALLENGE_MODE=0 质询星探；ASTRA_EPITOME=0 图导出压缩；ASTRA_AUTO_DISTILL=0 赛后自动蒸馏
ENV ASTRA_CHALLENGE_MODE=0 \
    ASTRA_EPITOME=0 \
    ASTRA_AUTO_DISTILL=0

COPY ./container/.agents /home/kali/workspace/.agents
COPY ./container/AGENTS.md /home/kali/workspace/AGENTS.md
COPY ./container/knowledge /home/kali/workspace/knowledge

# V9 体积治理（托管 3G 上传硬限，裸 fs 8.6G→目标 ~7G）：
# - 砍 OpenCL 整链 hashcat→pocl→clang-21→llvm-21（~776M；容器无 GPU，pocl 只是 CPU 模拟，
#   john+z3 全覆盖 f2 爆破场景，历届得分从未依赖 hashcat）。
#   教训：apt purge 带通配名时有不存在项会整批中止且被 || true 吞掉——首版静默失败，
#   OpenCL 链全留在镜像里。改为 dpkg 查实名再 purge。
# - UPX 压 Go 巨型二进制（cloudfox 311M/nuclei 122M/aliyun 90M/katana 46M/dalfox 33M/
#   kerbrute 8M → 合计省 ~380M；压后逐个 --version 验证，失败自动还原）
# - Awesome-POC 砍"网络设备漏洞"（94M，两靶场均无路由器/交换机题）
# - tencentcloud SDK 只留常用服务目录（全量 356M 装了 200+ 服务的 API 模型）
# - chisel 只留 linux_amd64/linux_arm64（隧道目标只会是 Linux）
# - 后装包的 doc/man/locale 复扫（layer1 清过，工具层又装回来一部分）
RUN set -e; purge_list=$(dpkg -l 2>/dev/null | grep -E "^ii\s+(hashcat|pocl|clang|llvm)-?[0-9]*" | awk '{print $2}' || true); \
    if [ -n "$purge_list" ]; then sudo apt-get purge -y $purge_list || true; sudo apt-get autoremove -y || true; fi; \
    for bin in cloudfox nuclei aliyun katana dalfox kerbrute; do \
      if [ -f "/usr/local/bin/$bin" ]; then \
        sudo cp "/usr/local/bin/$bin" "/tmp/$bin.bak"; \
        if sudo upx -9 --lzma -q "/usr/local/bin/$bin" >/dev/null 2>&1 && "/usr/local/bin/$bin" --version >/dev/null 2>&1 || "/usr/local/bin/$bin" -h >/dev/null 2>&1 || "/usr/local/bin/$bin" help >/dev/null 2>&1; then \
          echo "upx ok: $bin"; sudo rm -f "/tmp/$bin.bak"; \
        else \
          echo "upx failed, restore: $bin"; sudo cp "/tmp/$bin.bak" "/usr/local/bin/$bin"; sudo rm -f "/tmp/$bin.bak"; \
        fi; \
      fi; \
    done; \
    sudo rm -rf "/home/kali/pocs/Awesome-POC/网络设备漏洞" \
                /usr/share/chisel-common-binaries/chisel_*_darwin_* \
                /usr/share/chisel-common-binaries/chisel_*_openbsd_* \
                /usr/share/chisel-common-binaries/chisel_*_linux_386 \
                /usr/share/doc /usr/share/man /usr/share/locale \
                /var/cache/apt /var/log/*.log /tmp/* 2>/dev/null || true; \
    if cd /home/kali/.local/lib/python3.14/site-packages/tencentcloud 2>/dev/null; then \
      for d in */; do \
        case "${d%/}" in \
          common|cvm|vpc|scf|cam|sts|cls|monitor|cdb|redis|mysql|ckafka|clb|ssl|cdn|dnspod|tcr|cr|as|tag|organization) ;; \
          *) sudo rm -rf "$d" 2>/dev/null || true ;; \
        esac; \
      done; \
    fi; \
    sudo apt-get clean 2>/dev/null || true; true

WORKDIR /home/kali/workspace